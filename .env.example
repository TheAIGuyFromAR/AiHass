# Home Assistant connection
AIHASS_HASS_URL=http://homeassistant.local:8123
AIHASS_HASS_TOKEN=your_long_lived_access_token

# Database (PostgreSQL + optional TimescaleDB)
AIHASS_DATABASE_URL=postgresql+asyncpg://aihass:aihass@localhost:5432/aihass

# API server
AIHASS_API_HOST=0.0.0.0
AIHASS_API_PORT=8100

# MCP server
AIHASS_MCP_TRANSPORT=stdio
AIHASS_MCP_PORT=8101
